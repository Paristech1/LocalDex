#!/usr/bin/env node
// Stand-in for `gemini -p … -o stream-json`, for LocalDex tests only.
const c = require('./_common.cjs');
const a = process.argv.slice(2);
(async () => {
  if (a[0] === '--version') return console.log('0.63.0');
  const prompt = a[a.indexOf('-p') + 1] || '';
  const role = c.role(prompt);
  c.record('gemini', { argv: a, prompt });
  const ts = () => new Date().toISOString();
  c.out({ type: 'init', timestamp: ts(), session_id: 'g1', model: a.includes('-m') ? a[a.indexOf('-m') + 1] : 'gemini-3-pro' });
  c.out({ type: 'message', timestamp: ts(), role: 'user', content: prompt.slice(0, 40) });
  await c.sleep(300);
  if (c.flag('gemini_limit')) { c.out({ type: 'result', timestamp: ts(), status: 'error', error: { type: 'Error', message: 'Quota exceeded for quota metric. RESOURCE_EXHAUSTED (429)' }, stats: {} }); process.exit(1); }
  c.out({ type: 'message', timestamp: ts(), role: 'assistant', content: 'Reading the project. ', delta: true });
  c.out({ type: 'tool_use', timestamp: ts(), tool_name: 'read_file', tool_id: 'rf-1', parameters: { absolute_path: 'src/math.ts' } });
  await c.sleep(400);
  c.out({ type: 'tool_result', timestamp: ts(), tool_id: 'rf-1', status: 'success', output: 'export function add(a, b) { return a + b; }' });
  const text = c.answer(role, 'gemini', prompt);
  for (const ch of text.match(/.{1,16}/gs)) { c.out({ type: 'message', timestamp: ts(), role: 'assistant', content: ch, delta: true }); await c.sleep(25); }
  c.out({ type: 'result', timestamp: ts(), status: 'success', stats: { total_tokens: 7000, input_tokens: 6300, output_tokens: 700, duration_ms: 1500, tool_calls: 1 } });
})();
