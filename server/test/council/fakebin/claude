#!/usr/bin/env node
// Stand-in for Claude Code's print mode (stream-json), for LocalDex tests only.
const c = require('./_common.cjs');
const a = process.argv.slice(2);
(async () => {
  if (a[0] === '--version') return console.log('2.1.296 (Claude Code)');
  if (a[0] === 'auth' && a[1] === 'status') return console.log(JSON.stringify(c.flag('claude_signed_out') ? { loggedIn: false } : { loggedIn: true, authMethod: c.flag('claude_api') ? 'api_key' : 'claude.ai', email: 'paris@example.com' }));
  const prompt = await c.readStdin();
  const sys = a[a.indexOf('--append-system-prompt') + 1] || '';
  const role = c.role(sys);
  const model = a.includes('--model') ? a[a.indexOf('--model') + 1] : 'claude-sonnet-5-5';
  c.out({ type: 'system', subtype: 'init', session_id: 's1', model, apiKeySource: c.flag('claude_api') ? 'ANTHROPIC_API_KEY' : 'none', tools: ['Read', 'Grep', 'Edit'] });
  await c.sleep(300);
  if (c.flag('claude_limit')) {
    c.out({ type: 'result', subtype: 'success', is_error: true, result: 'Claude AI usage limit reached|' + Math.floor(Date.now() / 1000 + 3600), usage: { input_tokens: 0, output_tokens: 0 } });
    process.exit(1);
  }
  const lead = 'Let me look at the code first.\n';
  for (const ch of lead.match(/.{1,8}/gs)) { c.out({ type: 'stream_event', event: { type: 'content_block_delta', index: 0, delta: { type: 'text_delta', text: ch } } }); await c.sleep(40); }
  c.out({ type: 'assistant', message: { content: [{ type: 'text', text: lead }, { type: 'tool_use', id: 'toolu_1', name: 'Read', input: { file_path: 'src/math.ts' } }] } });
  await c.sleep(400);
  c.out({ type: 'user', message: { content: [{ type: 'tool_result', tool_use_id: 'toolu_1', content: [{ type: 'text', text: 'export function add(a: number, b: number) {\n  return a + b;\n}' }], is_error: false }] } });
  const text = c.answer(role, 'claude', prompt);
  for (const ch of text.match(/.{1,12}/gs)) { c.out({ type: 'stream_event', event: { type: 'content_block_delta', index: 0, delta: { type: 'text_delta', text: ch } } }); await c.sleep(25); }
  c.out({ type: 'assistant', message: { content: [{ type: 'text', text }] } });
  c.out({ type: 'result', subtype: 'success', is_error: false, result: text, num_turns: 2, total_cost_usd: 0.01, usage: { input_tokens: 2100, cache_read_input_tokens: 9000, output_tokens: 420 } });
})();
